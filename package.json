{
  "name": "dsh-big-flsh-aio",
  "version": "0.3.9",
  "description": "大肥鱼：统一管理 QQ 互通、历史导入、长期记忆、鱼的心情、主动搭话与插件更新。",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "contributors": [
    "CHINOSAMAAA (整合界面与 Plus 扩展)"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/logo.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/logo.png",
    "lib",
    "modules/qq/lib",
    "modules/qq/tools",
    "modules/qq/package.json",
    "modules/qq/LICENSE",
    "modules/qq/README.md",
    "modules/qq/CHANGELOG.md",
    "modules/memory/lib",
    "modules/memory/package.json",
    "modules/memory/LICENSE",
    "modules/memory/README.md",
    "modules/memory/CHANGELOG.md",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "LICENSE.md",
    "NOTICE",
    "CHANGELOG.md",
    "modules/mood/lib",
    "modules/mood/assets",
    "modules/mood/client.js",
    "modules/mood/package.json",
    "modules/mood/LICENSE",
    "modules/mood/README.md",
    "modules/mood/CHANGELOG.md",
    "modules/speak/lib",
    "modules/speak/package.json",
    "modules/speak/LICENSE",
    "modules/speak/README.md",
    "modules/speak/CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs && npm --prefix modules/qq test && npm --prefix modules/memory test && npm --prefix modules/mood test && npm --prefix modules/speak test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHINOSAMAAA/dsh-big-flsh-aio.git"
  },
  "homepage": "https://github.com/CHINOSAMAAA/dsh-big-flsh-aio#readme",
  "bugs": {
    "url": "https://github.com/CHINOSAMAAA/dsh-big-flsh-aio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "upstreamCompatibility": [
    {
      "name": "通到 QQ",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-qq-link",
      "version": "1.5.1",
      "commit": "fba7e3ee8ffb3a8f819a7823eb05186cfb782ecb",
      "forkName": "dsh-qq-link-plus",
      "forkUrl": "https://github.com/CHINOSAMAAA/dsh-qq-link-plus",
      "forkVersion": "1.5.1-12",
      "forkCommit": "f46ec1ce41fb42cb3a110ebdf4c095a5344fd8ab"
    },
    {
      "name": "鱼的记忆",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-fish-memory",
      "version": "1.5.2",
      "commit": "5124cc1fa5a3149e8a68cf1d858e24b5bf2a2eea",
      "forkName": "dsh-fish-memory-plus",
      "forkUrl": "https://github.com/CHINOSAMAAA/dsh-fish-memory-plus",
      "forkVersion": "1.5.2-2",
      "forkCommit": "6767011c1831e48a864f816d6a78f2c25f9eb7f9"
    },
    {
      "name": "鱼的心情",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-feiyu-mood",
      "version": "0.9.0",
      "commit": "02fddcaae0763651ecd65af5f644fe61f19de4bd",
      "modulePath": "modules/mood"
    },
    {
      "name": "主动搭话",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-speak-up",
      "version": "0.3.0",
      "commit": "e3bc6362208c693bb833ecf463ec6a20df4b6419",
      "modulePath": "modules/speak"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repositoryVersion": "0.3.9"
}
