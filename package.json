{
  "name": "dsh-big-flsh-aio",
  "version": "0.1.0",
  "description": "大肥鱼：在 DSH 主界面统一管理 QQ 互通、历史导入、长期记忆与插件更新。",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "contributors": [
    "CHINOSAMAAA (整合界面与 Plus 扩展)"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "modules/qq/lib",
    "modules/qq/tools",
    "modules/qq/package.json",
    "modules/qq/LICENSE",
    "modules/qq/README.md",
    "modules/qq/CHANGELOG.md",
    "modules/memory/lib",
    "modules/memory/package.json",
    "modules/memory/LICENSE",
    "modules/memory/README.md",
    "modules/memory/CHANGELOG.md",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "LICENSE.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs && npm --prefix modules/qq test && npm --prefix modules/memory test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHINOSAMAAA/dsh-big-flsh-aio.git"
  },
  "homepage": "https://github.com/CHINOSAMAAA/dsh-big-flsh-aio#readme",
  "bugs": {
    "url": "https://github.com/CHINOSAMAAA/dsh-big-flsh-aio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "react"
      ]
    }
  },
  "upstreamCompatibility": [
    {
      "name": "通到 QQ · dsh-qq-link",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-qq-link",
      "version": "1.5.1",
      "commit": "fba7e3ee8ffb3a8f819a7823eb05186cfb782ecb",
      "role": "原作者功能基线"
    },
    {
      "name": "鱼的记忆 · dsh-fish-memory",
      "author": "Yuuyuko-uu",
      "url": "https://github.com/Yuuyuko-uu/dsh-fish-memory",
      "version": "1.5.2",
      "commit": "5124cc1fa5a3149e8a68cf1d858e24b5bf2a2eea",
      "role": "原作者功能基线"
    },
    {
      "name": "通到 QQ Plus · dsh-qq-link-plus",
      "author": "Yuuyuko-uu；CHINOSAMAAA 扩展",
      "url": "https://github.com/CHINOSAMAAA/dsh-qq-link-plus",
      "version": "1.5.1-3",
      "commit": "1d49ee06a1300277d9d8f7e22fb8c75614218cc4",
      "role": "实际整合版本"
    },
    {
      "name": "鱼的记忆 Plus · dsh-fish-memory-plus",
      "author": "Yuuyuko-uu；CHINOSAMAAA 扩展",
      "url": "https://github.com/CHINOSAMAAA/dsh-fish-memory-plus",
      "version": "1.5.4",
      "commit": "10b5765ef7f2013fb2c17615c3c6fcf05b8776b7",
      "role": "实际整合版本"
    },
    {
      "name": "dsh-memory-rag",
      "author": "aonysen",
      "url": "https://github.com/Aonysen/dsh-memory-rag",
      "version": "源码参考",
      "commit": "9527a91f49863e7f16e109335e44b137e436dc41",
      "role": "Embedding 参考，非运行依赖"
    }
  ]
}
